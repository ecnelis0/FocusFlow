# Copy to .env and fill in. Never commit .env.

# --- Database ---
# Local dev default (no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./mistake_bank.db
# Production (Neon Postgres):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require

# --- AI analyzer ---
# stub   = deterministic offline analysis, no API key, used by tests
# agent  = Claude Agent SDK: uses your Claude plan via `claude auth login`. No key.
# claude = Anthropic API with an API key
AI_PROVIDER=agent
# ANTHROPIC_API_KEY=sk-ant-...      # only for AI_PROVIDER=claude
# ANTHROPIC_MODEL=claude-opus-5

# --- Scanning notes ---
# Recorded notes are transcribed locally with Whisper before Claude reads them.
# Needs `uv sync --extra audio` in backend/. Empty follows AI_PROVIDER.
# TRANSCRIBER=whisper
# WHISPER_MODEL=base

# --- Frontend ---
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
